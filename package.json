{
  "name": "infynno-mcat-question-bank-generator-root",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -p '[{name}]' -n 'backend,frontend' -c 'magenta.bold,cyan.bold' 'pnpm run dev:backend' 'pnpm run dev:frontend'",
    "clean:ports": "lsof -ti :8000 -ti :5173 | xargs kill -9 2>/dev/null || true",
    "dev:backend": "PYTHONPATH=backend ./.venv/bin/uvicorn app.main:app --port 8000 --reload",
    "dev:frontend": "pnpm --dir frontend exec vite",
    "build": "pnpm --dir frontend run build",
    "lint": "pnpm --dir frontend run lint",
    "lint:backend": "ruff check backend/",
    "format": "ruff format .",
    "format:check": "ruff format --check .",
    "test": "pnpm run test:backend",
    "test:backend": "PYTHONPATH=backend pytest backend/tests",
    "preview": "pnpm --dir frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
