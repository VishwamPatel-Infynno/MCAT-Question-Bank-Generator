{
  "name": "infynno-ucat-question-bank-generator-root",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"magenta.bold,cyan.bold\" \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "PYTHONPATH=backend ./.venv/bin/uvicorn app.main:app --port 8000 --reload",
    "dev:frontend": "pnpm --filter infynno-ucat-question-bank-generator dev",
    "build": "pnpm --filter infynno-ucat-question-bank-generator build",
    "lint": "pnpm --filter infynno-ucat-question-bank-generator lint",
    "preview": "pnpm --filter infynno-ucat-question-bank-generator preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
