# ==============================================================================
# UK UCAT Question Bank Generator — Environment Configuration Template
# Copy this file to '.env' and populate your API credentials:
#   cp .env.example .env
# ==============================================================================

# Primary LLM Model (DeepInfra Meta Llama 3.3 70B Instruct Turbo)
DEFAULT_TEXT_MODEL=deepinfra/meta-llama/Llama-3.3-70B-Instruct-Turbo
COST_PER_MILLION_INPUT_TOKENS=0.10
COST_PER_MILLION_OUTPUT_TOKENS=0.32

# Image Generation Model (black-forest-labs/FLUX-2-klein-4b)
DEFAULT_IMAGE_MODEL=black-forest-labs/FLUX-2-klein-4b
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_ITERS=0
IMAGE_COST_PER_BASE_UNIT=0.014

# API Credentials (DeepInfra is strictly required for Turbo Llama & FLUX.1)
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Multi-Agent Workflow Parameters
MAX_REGENERATION_ATTEMPTS=3
PASSING_SCORE_THRESHOLD=90

# Database Configuration (PostgreSQL 16)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://ucat_user:ucat_password@localhost:5432/ucat_db
