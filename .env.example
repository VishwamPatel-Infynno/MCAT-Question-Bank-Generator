# ==============================================================================
# Infynno MCAT Question Bank Generator - Environment Configuration Template
# Copy this file to '.env' and populate your API credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Model (DeepInfra DeepSeek V4.1 Flash 1017) & Pricing
# ------------------------------------------------------------------------------
DEFAULT_TEXT_MODEL=deepinfra/deepseek-ai/DeepSeek-V4.1-Flash-1017
COST_PER_MILLION_INPUT_TOKENS=0.098
COST_PER_MILLION_OUTPUT_TOKENS=0.294

# Dedicated DeepInfra Model Cascade / Fallback List
FAST_MODEL_CASCADE=["deepinfra/deepseek-ai/DeepSeek-V4.1-Flash-1017"]

# ------------------------------------------------------------------------------
# 2. Visual Stimuli & Image Generation (FLUX-2-klein-4b via DeepInfra)
# ------------------------------------------------------------------------------
DEFAULT_IMAGE_MODEL=black-forest-labs/FLUX-2-klein-4b
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_ITERS=0
IMAGE_COST_PER_BASE_UNIT=0.014

# ------------------------------------------------------------------------------
# 3. API Credentials
# ------------------------------------------------------------------------------
# DeepInfra API Key (required for DeepSeek V4.1 Flash & FLUX.2 Klein 4b)
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# ------------------------------------------------------------------------------
# 4. Multi-Agent Workflow Parameters & Psychometric Quality Thresholds
# ------------------------------------------------------------------------------
MAX_REGENERATION_ATTEMPTS=3
PASSING_SCORE_THRESHOLD=90
BATCH_PASSING_SCORE_THRESHOLD=85
DEFAULT_MAX_TOKENS=3000
REVIEWER_MAX_TOKENS=1800

# ------------------------------------------------------------------------------
# 5. Strict Temperature Settings (High Instruction Fidelity & Determinism)
# ------------------------------------------------------------------------------
DEFAULT_TEMPERATURE=0.2
GENERATOR_TEMPERATURE=0.2
REGENERATOR_TEMPERATURE=0.2
REVIEWER_TEMPERATURE=0.1
BLIND_SOLVER_TEMPERATURE=0.1

# ------------------------------------------------------------------------------
# 6. Blind-Solver Dual Validation Agent
# ------------------------------------------------------------------------------
ENABLE_BLIND_SOLVER=true
BLIND_SOLVER_CONFIDENCE_THRESHOLD=88
BLIND_SOLVER_MAX_TOKENS=1200

# ------------------------------------------------------------------------------
# 7. Global Multi-Batch Concurrency, Queues & Rate Limiting Controls
# ------------------------------------------------------------------------------
GLOBAL_MAX_CONCURRENT_JOBS=4
GLOBAL_MAX_CONCURRENT_LLM_CALLS=10
LLM_MAX_RETRIES=4
LLM_BASE_BACKOFF_SECONDS=1.5
WORKFLOW_MAX_WORKER_RETRIES=2

# ------------------------------------------------------------------------------
# 8. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://mcat_user:mcat_password@localhost:5432/mcat_db

# ------------------------------------------------------------------------------
# 9. Database Connection Pool Settings
# ------------------------------------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 10. CORS Trusted Origins (comma-separated or JSON list)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
